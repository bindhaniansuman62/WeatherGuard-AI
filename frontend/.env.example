VITE_API_BASE_URL=http://localhost:8000

# Live backend integration is enabled by default (VITE_USE_MOCK=false).
# To run the frontend in offline simulated demo mode without the FastAPI server,
# change this value to: VITE_USE_MOCK=true
VITE_USE_MOCK=false

# Firebase Web App Configuration (safe client config — never commit .env or service account keys)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Optional comma-separated list of enabled providers in Firebase Console:
# google,github,microsoft,password (defaults to all enabled when Firebase config is set)
VITE_FIREBASE_AUTH_PROVIDERS=google,github,microsoft,password
